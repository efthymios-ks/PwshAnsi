$script:AnsiEmojiTable = $null

# Built once, on the first :name: that is looked up.
function Get-AnsiEmojiTable {
    [CmdletBinding()]
    [OutputType([System.Collections.Generic.Dictionary[string, string]])]
    param()
    if ($null -ne $script:AnsiEmojiTable) { return $script:AnsiEmojiTable }

    $table = [System.Collections.Generic.Dictionary[string, string]]::new(
        [System.StringComparer]::OrdinalIgnoreCase)
    foreach ($line in $script:AnsiEmojiData.Split([char]10)) {
        $entry = $line.Trim()
        if ($entry.Length -eq 0) { continue }
        $split = $entry.IndexOf(' ')
        if ($split -lt 1) { continue }
        $glyph = ''
        foreach ($code in $entry.Substring($split + 1).Split(',')) {
            $glyph += [char]::ConvertFromUtf32([Convert]::ToInt32($code, 16))
        }
        $table[$entry.Substring(0, $split)] = $glyph
    }

    $script:AnsiEmojiTable = $table
    return $table
}

# The glyph for a name, or $null so the caller can leave the token alone.
function Get-AnsiEmoji {
    [CmdletBinding()]
    [OutputType([string])]
    param([Parameter(Mandatory)][AllowEmptyString()][string]$Name)
    if ([string]::IsNullOrEmpty($Name)) { return $null }
    $glyph = $null
    if ((Get-AnsiEmojiTable).TryGetValue($Name, [ref]$glyph)) { return $glyph }
    return $null
}

Export-ModuleMember -Function Get-AnsiEmojiTable, Get-AnsiEmoji

